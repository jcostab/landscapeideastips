---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact - Landscape Ideas Tips"
  description="Get in touch with Landscape Ideas Tips for questions, suggestions, or feedback about our garden and landscape content."
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Get in Touch</h1>
      
      <div class="bg-white rounded-lg shadow-md p-8">
        <p class="text-lg text-gray-700 mb-6">
          Have a question about our garden tips? Want to suggest a topic for a future article? 
          We'd love to hear from you!
        </p>

        <div class="space-y-6">
          <div>
            <h2 class="text-xl font-bold mb-3">Email Us</h2>
            <p class="text-gray-700 mb-2">
              For general inquiries, topic suggestions, or feedback:
            </p>
            <a 
              href="mailto:tips@landscapeideastips.com" 
              class="inline-flex items-center text-primary-600 hover:text-primary-800 font-medium transition-colors text-lg"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              tips@landscapeideastips.com
            </a>
          </div>

          <div class="border-t border-gray-200 pt-6">
            <h2 class="text-xl font-bold mb-3">Looking for Services?</h2>
            <p class="text-gray-700 mb-4">
              We're a tips blog, not a service provider. For professional lawn and garden services 
              on the Mornington Peninsula, check out our partners:
            </p>
            <div class="space-y-3">
              <div>
                <strong class="text-gray-900">For lawn mowing, edging & regular care:</strong>
                <br />
                <a 
                  href="https://mowingmagic.com.au" 
                  target="_blank"
                  rel="noopener"
                  class="text-primary-600 hover:text-primary-800 font-medium transition-colors"
                >
                  Mowing Magic →
                </a>
              </div>
              <div>
                <strong class="text-gray-900">For hedges, beds, irrigation & landscaping:</strong>
                <br />
                <a 
                  href="https://peninsulahardyards.com.au" 
                  target="_blank"
                  rel="noopener"
                  class="text-primary-600 hover:text-primary-800 font-medium transition-colors"
                >
                  Peninsula Hard Yards →
                </a>
              </div>
            </div>
          </div>

          <div class="border-t border-gray-200 pt-6">
            <h2 class="text-xl font-bold mb-3">Response Time</h2>
            <p class="text-gray-700">
              We typically respond to inquiries within 2-3 business days. Thanks for your patience!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
