---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => {
    return data.draft !== true;
  });
  
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Determine CTA based on category
const ctaConfig = {
  'Lawns': {
    service: 'Mowing Magic',
    url: 'https://mowingmagic.com.au',
    description: 'Professional lawn mowing, edging, and regular lawn care services'
  },
  'Hedges & Pruning': {
    service: 'Peninsula Hard Yards',
    url: 'https://peninsulahardyards.com.au',
    description: 'Expert hedge trimming, pruning, and garden maintenance'
  },
  'Garden Beds': {
    service: 'Peninsula Hard Yards',
    url: 'https://peninsulahardyards.com.au',
    description: 'Garden bed installation, planting, and maintenance services'
  },
  'Seasonal': {
    service: 'Peninsula Hard Yards',
    url: 'https://peninsulahardyards.com.au',
    description: 'Seasonal garden clean-ups and maintenance'
  },
  'DIY vs Hire': {
    service: 'Mowing Magic or Peninsula Hard Yards',
    url: 'https://mowingmagic.com.au',
    description: 'Professional lawn and garden services when you need them'
  }
};

const cta = ctaConfig[post.data.category as keyof typeof ctaConfig] || ctaConfig['DIY vs Hire'];
---

<Layout 
  title={`${post.data.title} - Landscape Ideas Tips`}
  description={post.data.description}
  image={post.data.image}
>
  <article class="container mx-auto px-4 py-12">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-block px-4 py-1.5 text-sm font-semibold text-primary-700 bg-primary-100 rounded-full">
            {post.data.category}
          </span>
          <time datetime={post.data.pubDate.toISOString()} class="text-gray-600">
            {formattedDate}
          </time>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
          {post.data.title}
        </h1>
        <p class="text-xl text-gray-600">
          {post.data.description}
        </p>
      </header>

      {post.data.image && (
        <div class="mb-8 rounded-lg overflow-hidden aspect-video bg-gray-200 flex items-center justify-center text-gray-400">
          <span>Image placeholder</span>
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-lg prose-primary max-w-none mb-12">
        <Content />
      </div>

      <!-- CTA Box -->
      <div class="bg-primary-50 border-2 border-primary-200 rounded-lg p-6 mb-12">
        <h3 class="text-xl font-bold mb-3 text-gray-900">Need a Hand?</h3>
        <p class="text-gray-700 mb-4">
          {cta.description}. Get a quote from our trusted Peninsula partners.
        </p>
        <a 
          href={cta.url}
          target="_blank"
          rel="noopener"
          class="inline-block px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors"
        >
          Contact {cta.service} →
        </a>
        <p class="text-xs text-gray-600 mt-3">
          <em>Disclosure: We share links to related local services that serve our readers in the Peninsula area.</em>
        </p>
      </div>

      <!-- Back to Blog -->
      <div class="text-center pt-8 border-t border-gray-200">
        <a 
          href="/blog" 
          class="inline-flex items-center text-primary-600 hover:text-primary-800 font-medium transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all tips
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose {
    @apply text-gray-800;
  }
  .prose h2 {
    @apply text-2xl font-bold mt-8 mb-4 text-gray-900;
  }
  .prose h3 {
    @apply text-xl font-bold mt-6 mb-3 text-gray-900;
  }
  .prose p {
    @apply mb-4 leading-relaxed;
  }
  .prose ul, .prose ol {
    @apply mb-4 pl-6;
  }
  .prose li {
    @apply mb-2;
  }
  .prose strong {
    @apply font-semibold text-gray-900;
  }
  .prose a {
    @apply text-primary-600 hover:text-primary-800 underline;
  }
</style>
