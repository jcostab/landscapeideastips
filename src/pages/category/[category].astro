---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const categories = {
    'lawns': 'Lawns',
    'garden-beds': 'Garden Beds',
    'hedges-and-pruning': 'Hedges & Pruning',
    'seasonal': 'Seasonal',
    'diy-vs-hire': 'DIY vs Hire'
  };

  const posts = await getCollection('posts', ({ data }) => {
    return data.draft !== true;
  });
  
  return Object.entries(categories).map(([slug, category]) => {
    const categoryPosts = posts.filter(post => post.data.category === category);
    
    return {
      params: { category: slug },
      props: { 
        category,
        posts: categoryPosts.sort((a, b) => 
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        )
      },
    };
  });
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<Layout 
  title={`${category} Tips - Landscape Ideas Tips`}
  description={`Browse all our ${category.toLowerCase()} tips and guides for Australian gardens.`}
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{category}</h1>
      <p class="text-xl text-gray-600">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this category
      </p>
      <div class="mt-6">
        <a 
          href="/blog" 
          class="text-primary-600 hover:text-primary-800 font-medium transition-colors"
        >
          ← Browse all categories
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          slug={post.slug}
          pubDate={post.data.pubDate}
          image={post.data.image}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600 text-lg">No posts in this category yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>
