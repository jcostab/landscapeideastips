---
interface Props {
  category: string;
  count?: number;
}

const { category, count } = Astro.props;
const slug = category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and');
---

<a 
  href={`/category/${slug}`}
  class="inline-flex items-center px-4 py-2 bg-white border-2 border-primary-200 rounded-full text-primary-700 hover:bg-primary-50 hover:border-primary-300 transition-all duration-200 font-medium"
>
  {category}
  {count !== undefined && (
    <span class="ml-2 px-2 py-0.5 bg-primary-100 text-primary-700 rounded-full text-xs font-bold">
      {count}
    </span>
  )}
</a>
