---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  pubDate: Date;
  image?: string;
}

const { title, description, category, slug, pubDate, image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
  {image && (
    <a href={`/blog/${slug}`} class="block">
      <img src={image} alt={title} class="w-full aspect-video object-cover" />
    </a>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 text-xs font-semibold text-primary-700 bg-primary-100 rounded-full">
        {category}
      </span>
      <span class="text-sm text-gray-500">{formattedDate}</span>
    </div>
    <h3 class="text-xl font-bold mb-2">
      <a href={`/blog/${slug}`} class="text-gray-900 hover:text-primary-700 transition-colors">
        {title}
      </a>
    </h3>
    <p class="text-gray-600 mb-4 line-clamp-3">{description}</p>
    <a 
      href={`/blog/${slug}`} 
      class="inline-flex items-center text-primary-600 hover:text-primary-800 font-medium transition-colors"
    >
      Read more 
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
